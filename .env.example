# --- Contact form email (Resend) ---
# Copy this file to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables). Never commit real keys.

# API key from https://resend.com (Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives enquiries (your real mailbox)
CONTACT_TO_EMAIL=hello@citymorehomes.com

# "From" address shown on the email — MUST be on a domain you've verified in
# Resend (Dashboard → Domains → add citymorehomes.com and the DKIM/SPF records).
# Until the domain is verified you can only send from onboarding@resend.dev.
CONTACT_FROM_EMAIL=CITYMORE Homes <website@citymorehomes.com>
